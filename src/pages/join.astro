---
import SectionHeaderTitle from '../components/SectionHeaderTitle.astro';
import Square from '../components/Square.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLayout from '../layouts/SectionLayout.astro';
import JobCard from '../components/join/JobCard.astro';
import TextBubble from '../components/about/TextBubble.astro';
import TextBubbleWrap from '../components/about/TextBubbleWrap.astro';
import _jobs from '../data/jobs.json' assert { type: 'json' };
import type { JobListing } from '../scripts/types';

const jobs = _jobs as JobListing[];
---

<BaseLayout title="Mosaiq Software - Join Us">
    <SectionLayout id="join">
        <SectionHeaderTitle>Join Mosaiq</SectionHeaderTitle>
        <Square
            width={10}
            size={'30vw'}
            color="var(--mosaiq-blue)"
            top="200px"
            right="5%"
            rotation="15deg"
        />
        <Square
            width={10}
            size={'25vw'}
            color="var(--mosaiq-magenta)"
            top="600px"
            left="10%"
            rotation="45deg"
        />
        <Square
            width={10}
            size={'35vw'}
            color="var(--mosaiq-pink)"
            top="100px"
            left="60%"
            rotation="25deg"
        />

        <TextBubbleWrap>
            <TextBubble amount="10%">
                <h1>Build something awesome with us</h1>
            </TextBubble>
            <TextBubble amount="15%">
                <p class="lead">Mosaiq is a nonprofit software collective where passionate builders come together to create delightful web experiences. We turn wild ideas into real projects, gain hands-on experience, and have fun doing it.</p>
            </TextBubble>
            <TextBubble amount="20%">
                <p class="lead">Whether you're hunting for your next big project or just want something fun to tinker with on weekends, Mosaiq has a spot for you. We welcome coders, designers, dreamers, and anyone who loves to create.</p>
            </TextBubble>
        </TextBubbleWrap>

        <div class="jobs-section">
            <h2>Open Positions</h2>
            <div class="jobs-grid">
                {jobs.map((job) => <JobCard job={job} />)}
            </div>
        </div>

        <TextBubbleWrap>
            <TextBubble amount="15%">
                <h3>Not seeing a fit?</h3>
            </TextBubble>
            <TextBubble amount="20%">
                <p>
                    We're always open to meeting talented people. If you're passionate about building software and want to be part of our community, reach out to us at{' '}
                    <a
                        href="mailto:join@mosaiq.dev"
                        target="_blank"
                        >join@mosaiq.dev</a
                    >
                </p>
            </TextBubble>
        </TextBubbleWrap>
    </SectionLayout>
</BaseLayout>
<style>
    h1 {
        font-size: 3rem;
        margin-bottom: var(--spacing-lg);
        line-height: 1.2;
    }

    .lead {
        font-size: var(--font-size-lg);
        line-height: 1.6;
        max-width: 80ch;
    }

    h3 {
        font-size: 1.5rem;
        margin-bottom: var(--spacing-md);
    }

    p {
        font-size: var(--font-size-md);
        line-height: 1.6;
        max-width: 80ch;
    }

    a {
        color: var(--mosaiq-magenta);
        text-decoration: underline;
    }

    .jobs-section {
        max-width: 1200px;
        margin: 4rem auto;
        z-index: 10;
        position: relative;
    }

    .jobs-section h2 {
        font-size: 2rem;
        margin-bottom: var(--spacing-xl);
        text-align: center;
        paint-order: stroke fill;
        -webkit-text-stroke: 0.33em var(--color-background);
    }

    .jobs-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: var(--spacing-lg);
        padding: 0 var(--spacing-md);
    }

    @media (max-width: 768px) {
        h1 {
            font-size: 2rem;
        }

        .lead {
            font-size: var(--font-size-md);
        }

        .jobs-grid {
            grid-template-columns: 1fr;
        }

        .jobs-section h2 {
            font-size: 1.5rem;
        }
    }
</style>
