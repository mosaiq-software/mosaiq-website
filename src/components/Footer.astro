---
import SimpleMosaiqLogo from './SimpleMosaiqLogo.astro';

const year = new Date().getFullYear();
---

<footer>
    <div class="column footer-links">
        <h2 class="bkg-text">Organization</h2>
        <a
            href="/about"
            data-clarity-click="Footer-About"
            >About</a
        >
        <a
            href="/join"
            data-clarity-click="Footer-Join"
            >Join</a
        >
        <br />
        <h2 class="bkg-text">Elsewhere</h2>
        <a
            href="https://github.com/mosaiq-software"
            target="_blank"
            data-clarity-click="Footer-GitHub"
            >GitHub</a
        >
        <a
            href="https://www.linkedin.com/company/mosaiq-software"
            target="_blank"
            data-clarity-click="Footer-LinkedIn"
            >LinkedIn</a
        >
    </div>
    <div class="column">
        <a
            href="/"
            data-clarity-click="Footer-Home"
        >
            <SimpleMosaiqLogo />
        </a>
        <a
            href="/"
            style="text-decoration: none;"
            data-clarity-click="Footer-Home"
        >
            <h2 class="white-text">Mosaiq Software</h2>
        </a>
        <p class="white-text">&copy; {year} Mosaiq Software</p>
    </div>
    <div class="column footer-links">
        <h2
            class="bkg-text"
            data-clarity-click="Footer-Resources"
        >
            Resources
        </h2>
        <a
            href="/brand"
            data-clarity-click="Footer-BrandAssets"
            >Brand Assets</a
        >
        <a
            href="/projects"
            data-clarity-click="Footer-Projects"
            >Projects</a
        >
        <br />
        <h2 class="bkg-text">Website Design</h2>
        <a
            href="https://matthagger.me/"
            target="_blank"
            data-clarity-click="Footer-Credits Footer-Credits-MattHagger"
            >Matt Hagger</a
        >
        <a
            href="https://samranda.com"
            target="_blank"
            data-clarity-click="Footer-Credits Footer-Credits-SamRanda"
            >Sam Randa</a
        >
    </div>
</footer>

<style>
    footer {
        width: 100%;
        display: flex;
        flex-direction: row;
        justify-content: space-evenly;
        align-items: flex-start;
        padding: var(--spacing-lg) var(--spacing-lg);
        z-index: 3;
        background-color: var(--mosaiq-pink);
        min-height: 50vh;
        color: var(--color-background);

        @media screen and (max-width: 768px) {
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: var(--spacing-xl);
        }
    }
    .column {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--spacing-md);
    }
    .white-text {
        color: var(--color-background);
    }
    .bkg-text {
        color: #fb3b7c;
    }
</style>
