---
import type { JobListing } from '../../scripts/types';
import { JobApplicationForm } from './JobApplicationForm';

interface Props {
    job: JobListing;
}

const { job } = Astro.props;
const applicationPortalUrl = import.meta.env.APPLICATION_PORTAL_URL || '';
---

<section class="application-section">
    <h2>Apply for this Position</h2>
    <p class="application-intro">We're excited that you're interested in joining Mosaiq! Please fill out the application form below. We'll review your submission and get back to you within a week!</p>

    <JobApplicationForm
        client:load
        job={job}
        applicationPortalUrl={applicationPortalUrl}
    />
</section>

<style>
    .application-section {
        max-width: 800px;
        margin: 4rem auto;
        padding: var(--spacing-xl);
        background-color: var(--color-background-transparent);
        backdrop-filter: blur(10px);
        border: 1px solid var(--color-text);
        border-radius: 8px;
        z-index: 10;
        position: relative;
    }

    .application-section h2 {
        font-size: 2rem;
        margin-bottom: var(--spacing-md);
        paint-order: stroke fill;
        -webkit-text-stroke: 0.33em var(--color-background);
    }

    .application-intro {
        font-size: var(--font-size-md);
        color: var(--color-text-secondary);
        margin-bottom: var(--spacing-xl);
    }

    @media (max-width: 768px) {
        .application-section {
            padding: var(--spacing-md);
            margin: 2rem var(--spacing-md);
        }

        .application-section h2 {
            font-size: 1.5rem;
        }
    }

    @media (max-width: 375px) {
        .application-section {
            padding: var(--spacing-sm);
            margin: 1rem var(--spacing-sm);
            border-radius: 4px;
        }

        .application-section h2 {
            font-size: 1.25rem;
        }
    }
</style>
