---
import type { JobListing } from '../../scripts/types';
import { JobApplicationForm } from './JobApplicationForm';

interface Props {
    job: JobListing;
}

const { job } = Astro.props;
const applicationPortalUrl = import.meta.env.APPLICATION_PORTAL_URL || '';
---

<section class="application-section">
    <h2>Apply for this Position</h2>
    <p class="application-intro">We're excited that you're interested in joining Mosaiq! Please fill out the application form below. We'll review your submission and get back to you within a week!</p>

    <JobApplicationForm
        client:load
        job={job}
        applicationPortalUrl={applicationPortalUrl}
    />
</section>

<style>
    .application-section {
        max-width: 800px;
        margin: 4rem auto;
        padding: var(--spacing-xl);
        background-color: var(--color-background-transparent);
        backdrop-filter: blur(10px);
        border: 1px solid var(--color-text);
        border-radius: 8px;
        z-index: 10;
        position: relative;
    }

    .application-section h2 {
        font-size: 2rem;
        margin-bottom: var(--spacing-md);
        paint-order: stroke fill;
        -webkit-text-stroke: 0.33em var(--color-background);
    }

    .application-intro {
        font-size: var(--font-size-md);
        color: var(--color-text-secondary);
        margin-bottom: var(--spacing-xl);
    }

    :global(.application-form) {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-lg);
    }

    :global(.form-group) {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
    }

    :global(label) {
        font-family: 'Clash Display', sans-serif;
        font-weight: 600;
        font-size: var(--font-size-md);
        color: var(--color-text);
    }

    :global(.form-input) {
        padding: var(--spacing-md);
        border: 1px solid var(--color-text);
        border-radius: 8px;
        font-family: 'Clash Grotesk', sans-serif;
        font-size: var(--font-size-md);
        background-color: var(--color-background);
        color: var(--color-text);
        transition: border-color 0.2s ease;
    }

    :global(.form-input:focus) {
        outline: none;
        border-color: var(--mosaiq-magenta);
    }

    :global(textarea.form-input) {
        resize: vertical;
        min-height: 120px;
    }

    :global(.file-input) {
        cursor: pointer;
    }

    :global(.file-hint) {
        font-size: var(--font-size-sm);
        color: var(--color-text-secondary);
    }

    :global(.submit-button) {
        padding: var(--spacing-md) var(--spacing-xl);
        background-color: var(--mosaiq-magenta);
        color: var(--color-background);
        border: none;
        border-radius: var(--border-radius-full);
        font-family: 'Clash Display', sans-serif;
        font-size: var(--font-size-md);
        font-weight: 600;
        cursor: pointer;
        transition:
            background-color 0.2s ease,
            transform 0.2s ease;
        align-self: flex-start;
    }

    :global(.submit-button:hover) {
        background-color: var(--mosaiq-pink);
        transform: translateY(-2px);
    }

    :global(.submit-button:active) {
        transform: translateY(0);
    }

    :global(.submit-button:disabled) {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }

    @media (max-width: 768px) {
        .application-section {
            padding: var(--spacing-md);
            margin: 2rem var(--spacing-md);
        }

        .application-section h2 {
            font-size: 1.5rem;
        }
    }

    @media (max-width: 375px) {
        .application-section {
            padding: var(--spacing-sm);
            margin: 1rem var(--spacing-sm);
            border-radius: 4px;
        }

        .application-section h2 {
            font-size: 1.25rem;
        }

        :global(label) {
            font-size: var(--font-size-sm);
        }

        :global(.form-input) {
            padding: var(--spacing-sm);
            font-size: var(--font-size-sm);
        }

        :global(.submit-button) {
            width: 100%;
            align-self: stretch;
        }
    }
</style>
