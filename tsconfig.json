{
    "extends": "astro/tsconfigs/base",
    "compilerOptions": {
        "target": "es2015",
        "module": "ES2022",
        "baseUrl": "./",
        "paths": {
            "@/*": ["src/*/index", "src/*"]
        },
        "strict": true,
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "outDir": "./dist/",
        "sourceMap": true,
        "noImplicitAny": false,
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "jsxImportSource": "preact"
    },
    "include": ["./src/**/*"],
    "exclude": ["node_modules"]
}
